# ============================================================
# HERMES AUTONOMOUS RENTAL MONITOR — CONFIGURATION (.env)
# ============================================================

# 1. إعدادات التيليجرام (Telegram Notifications)
# للحصول على التوكن: افتح @BotFather على تيليجرام واضغط /newbot
TELEGRAM_BOT_TOKEN=

# للحصول على Chat ID الخاص بك: راسل @userinfobot على تيليجرام وانسخ رقم Id
TELEGRAM_CHAT_ID=

# 2. معايير البحث والميزانية (Search & Budget Parameters)
TARGET_MAX_BUDGET_TL=36000
SCORE_INSTANT_ALERT=75
SCORE_MULTI_CHANNEL_ALERT=85

# 3. إعدادات المجدول (Scheduler)
CYCLE_INTERVAL_MINUTES=20

# 4. إعدادات البريد الإلكتروني (اختياري - Optional SMTP Backup)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_RECIPIENT_EMAIL=
