# ============================================================
# HERMES AUTONOMOUS RENTAL MONITOR — CONFIGURATION (.env)
# Copy to .env and fill in. Every value is optional.
# ============================================================

# 1. إعدادات التيليجرام (Telegram Notifications)
# للحصول على التوكن: افتح @BotFather على تيليجرام واضغط /newbot
TELEGRAM_BOT_TOKEN=
# للحصول على Chat ID الخاص بك: راسل @userinfobot على تيليجرام وانسخ رقم Id
TELEGRAM_CHAT_ID=

# 2. معايير البحث والميزانية (Search & Budget Parameters)
# Target monthly cost (rent + aidat). Listings above it score 0 on price.
TARGET_MAX_BUDGET_TL=36000
# Hard limit: listings costing more are ignored entirely.
EXCEPTIONAL_BUDGET_LIMIT_TL=42000
ALLOWED_ROOMS=1+0,1+1,2+1

# 3. حدود الإشعارات (Alert thresholds, 0-100)
# Telegram alert for new listings
SCORE_INSTANT_ALERT=75
# Telegram + email
SCORE_MULTI_CHANNEL_ALERT=85
# Included in the daily digest and price-drop alerts
SCORE_DAILY_DIGEST=65
MAX_ALERTS_PER_CYCLE=10

# 4. إعدادات المجدول (Scheduler)
CYCLE_INTERVAL_MINUTES=20
DAILY_DIGEST_HOUR=20
# Re-check listings at least this often to detect removals and price changes
REVERIFY_HOURS=6

# 5. إعدادات البريد الإلكتروني (اختياري - Optional SMTP)
# Gmail/Yahoo need an "App Password", not your normal password.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_RECIPIENT_EMAIL=
# Email is enabled automatically when the three values above are set; set to false to disable.
# EMAIL_ENABLED=true

# 6. Advanced
# DATABASE_PATH=data/rentals.db
# WATCHLIST_PATH=watchlist.txt
# REQUEST_DELAY_SECONDS=1.0
# LOG_LEVEL=INFO
